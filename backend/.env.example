# Nexaura.exe Backend Environment Variables Template
PORT=5000
NODE_ENV=production

# Hosted MySQL Database Configuration (e.g. Aiven, PlanetScale, Railway, TiDB)
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=nexaura_exe

# Session Secret (Generate a long random alphanumeric string)
SESSION_SECRET=your_long_random_session_secret_here

# Deployed Frontend Client URL (e.g. https://nexaura-frontend.onrender.com)
CLIENT_URL=https://nexaura-frontend.onrender.com

# Optional Showcase Operative Demo Account
DEMO_USERNAME=demo_netrunner
DEMO_EMAIL=demo@nexaura.exe
DEMO_PASSWORD=your_secure_demo_password
